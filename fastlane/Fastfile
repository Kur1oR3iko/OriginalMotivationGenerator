require "shellwords"

default_platform(:ios)

BUNDLE_ID = "com.kurio.original-motivation-generator"
PROJECT = "OriginalMotivationGenerator.xcodeproj"
SCHEME = "OriginalMotivationGenerator"

def api_key
  app_store_connect_api_key(
    key_id: ENV.fetch("APP_STORE_CONNECT_KEY_ID"),
    issuer_id: ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
    key_content: ENV.fetch("APP_STORE_CONNECT_KEY"),
    is_key_content_base64: ENV["APP_STORE_CONNECT_KEY_IS_BASE64"] == "true"
  )
end

platform :ios do
  desc "Archive and upload a TestFlight build"
  lane :testflight_release do
    build_number = ENV["BUILD_NUMBER"] || Time.now.strftime("%Y%m%d%H%M")

    increment_build_number(
      build_number: build_number,
      xcodeproj: PROJECT
    )

    update_code_signing_settings(
      use_automatic_signing: false,
      team_id: ENV.fetch("APPLE_TEAM_ID"),
      code_sign_identity: "Apple Distribution",
      bundle_identifier: BUNDLE_ID,
      path: PROJECT
    )

    profile_dir = File.expand_path("~/Library/MobileDevice/Provisioning Profiles")
    profile = Dir[File.join(profile_dir, "*.mobileprovision")].first
    profile_name = nil
    if profile
      plist = `security cms -D -i #{profile.shellescape}`
      if plist =~ /<key>Name<\/key>\s*<string>([^<]+)<\/string>/
        profile_name = $1
      end
    end

    build_app(
      project: PROJECT,
      scheme: SCHEME,
      configuration: "Release",
      export_method: "app-store",
      destination: "generic/platform=iOS",
      xcargs: "DEVELOPMENT_TEAM=#{ENV.fetch("APPLE_TEAM_ID")} CODE_SIGN_STYLE=Manual",
      export_options: {
        method: "app-store",
        signingStyle: "manual",
        teamID: ENV.fetch("APPLE_TEAM_ID"),
        provisioningProfiles: {
          BUNDLE_ID => profile_name || ENV["PROVISIONING_PROFILE_NAME"] || "AppStore"
        },
        uploadSymbols: true,
        compileBitcode: false
      }
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
      changelog: ENV["RELEASE_NOTES"] || "Automated GitHub Actions build #{build_number}."
    )
  end
end
